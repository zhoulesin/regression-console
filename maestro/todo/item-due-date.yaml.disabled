appId: com.cozyla.choresreward
name: Todo creation sets due date and card shows DueTime
---
# 功能点 2.6：完整创建时设置截止日期，卡片展示 DueTime。
# 只验证一件事：创建对话框内设置的日期/时间在保存后体现在夹具卡片上。
#
# 已知问题：CalendarSelectView 是自定义 View，日期是 Canvas 绘制的
# 无法通过 text/id 定位，需要使用坐标点击
# 坐标需要根据实际设备调整

- runFlow: subflows/cleanup-fixture.yaml
- runFlow: subflows/create-fixture-list.yaml

# --- 打开完整的创建对话框（使用根页的 Add 按钮）---
- tapOn:
    id: "com.cozyla.choresreward:id/iv_todo_root_add"

# --- 输入标题 ---
- tapOn:
    id: "com.cozyla.choresreward:id/editName"
- inputText: "E2E_DueDate"

# --- 确认选择的是夹具 List ---
- assertVisible:
    id: "com.cozyla.choresreward:id/txtTodoListDesc"
    text: "E2E Todo"

# --- 设置截止日期：打开日期选择弹窗 → 选日期 → 选时间 → 保存 ---
# 1) selectDate 弹出日期选择弹窗（SelectDatePopup）
- tapOn:
    id: "com.cozyla.choresreward:id/selectDate"

# 2) 在日历中选择日期（明天，2026-09-10）
# CalendarSelectView 是自定义 View，日期是 Canvas 绘制的
# 使用 extendedWaitUntil 等待弹窗完全显示
- extendedWaitUntil:
    visible:
      id: "com.cozyla.choresreward:id/calendarSelectView"
    timeout: 3000

# 使用坐标点击日期 "10"
# 日历布局：每格 36dp，7列，从左上角开始
# 需要根据实际设备调整坐标
# 这里使用百分比坐标，需要在真机上调试
- tapOn:
    point: "50%,55%"
    # 注意：这个坐标是估算的，需要根据实际设备调整
    # 如果测试失败，需要查看 UI 层级调整坐标

# 3) llSelectTime 弹出时间选择列表（SelectTimePopup）
# 时间选择器是一个 RecyclerView 列表，点击列表项选择时间
- tapOn:
    id: "com.cozyla.choresreward:id/llSelectTime"

# 4) 在时间列表中选择一个时间（如 "10:00 AM"）
# 时间列表项使用 tv_chore_time_picker TextView
- tapOn:
    text: "10:00 AM"

# 5) txtSave 关闭日期选择弹窗
- tapOn:
    id: "com.cozyla.choresreward:id/txtSave"

# --- fail-closed：断言创建对话框内日期已设置 ---
# llDate 应该可见（选择了日期后，llDate 会显示，llSelectDate 会隐藏）
- assertVisible:
    id: "com.cozyla.choresreward:id/llDate"
# txtTime 应该显示选择的时间
- assertVisible:
    id: "com.cozyla.choresreward:id/txtTime"
    text: "10:00 AM"

# --- 创建 Todo ---
- tapOn:
    id: "com.cozyla.choresreward:id/txtSave"

# --- 结果：夹具卡片内 cons_extra_container 可见、ll_duetime_container 可见、tv_todoitem_duetime 包含日期 ---
- extendedWaitUntil:
    visible:
      id: "com.cozyla.choresreward:id/cons_extra_container"
      childOf:
        containsDescendants:
          - id: "com.cozyla.choresreward:id/tv_todo_info_title"
            text: "E2E_DueDate"
          - id: "com.cozyla.choresreward:id/tv_todolist_title"
            text: "E2E Todo"
    timeout: 5000
- assertVisible:
    id: "com.cozyla.choresreward:id/ll_duetime_container"
    childOf:
      containsDescendants:
        - id: "com.cozyla.choresreward:id/tv_todo_info_title"
          text: "E2E_DueDate"
        - id: "com.cozyla.choresreward:id/tv_todolist_title"
          text: "E2E Todo"
- assertVisible:
    id: "com.cozyla.choresreward:id/tv_todoitem_duetime"
    text: ".*Sep 10.*"
    childOf:
      containsDescendants:
        - id: "com.cozyla.choresreward:id/tv_todo_info_title"
          text: "E2E_DueDate"
        - id: "com.cozyla.choresreward:id/tv_todolist_title"
          text: "E2E Todo"
